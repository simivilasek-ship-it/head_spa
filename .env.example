# Přesný odkaz na rezervaci Notino Salony (otevírá se v nové záložce).
# Stejná URL je výchozí v src/lib/content.ts, takže ji má i build bez tohoto souboru.
NEXT_PUBLIC_BOOKING_URL=https://www.notino.cz/salony/sarya-head-spa_1/

# Google recenze — odkaz na profil (Maps → Sdílet).
# Číslo a počet doplňte až z ověřeného Google Business. Prázdné = na webu se nezobrazí.
# NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://maps.google.com/?cid=...
# NEXT_PUBLIC_GOOGLE_RATING=
# NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=

# true = zobrazí FOTO: placeholdery (jen pro vývoj)
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
